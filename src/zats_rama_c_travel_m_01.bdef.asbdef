projection;
strict ( 2 );
use side effects;
use collaborative draft;

define behavior for ZATS_RAMA_C_TRAVEL_M_01 alias Travel
//Now we have another behaviour implementation class in behaviour pool
implementation in class ZCL_ATS_RAMA_AUGMNT_TRAV unique  //// Class for 'AUGUMENT' operation
{
  use create ( augment ); ////Default value assigned while creating a new record or once click on the 'Create' btn.
  use update;
  use delete;

  use action Activate;
  use action Edit;
  use action Resume;
  use action Prepare;
  use action Discard;
  use action Share;
  use action validateCustomer;

  use action copyTravel;
  use association _Booking { create; with draft; }
  use association _Attachments { create; with draft; }
}

define behavior for ZATS_RAMA_C_BOOKING_M_01 alias Booking
{
  use update;
  use delete;

  use association _Travel { with draft; }
  use association _BookingSuppl { create; with draft; }
}

define behavior for ZATS_RAMA_C_BOOKNGSUPPL_M_01 alias BookSuppl
{
  use update;
  use delete;

  use association _Travel { with draft; }
  use association _Booking { with draft; }
}

define behavior for ZATS_RAMA_C_ATTACH_M_01 alias Attachments
{
  use update;
  use delete;

  use association _Travel { with draft; }
}